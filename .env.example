# ==============================================================================
# MYTRADEVIEW ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and populate with your own credentials.
# NEVER commit the active .env file to version control.
# ==============================================================================

# Execution Mode: simulation | paper | live
# SAFETY DEFAULT: paper (Live execution requires explicit LIVE_TRADING_ACK)
EXECUTION_MODE=paper
LIVE_TRADING_ACK=false

# FYERS Broker Credentials
FYERS_CLIENT_ID=YOUR_APP_ID_HERE
FYERS_SECRET_KEY=YOUR_SECRET_KEY_HERE
FYERS_REDIRECT_URI=https://127.0.0.1:5000/login
FYERS_USER_ID=YOUR_FYERS_USER_ID

# Access Token Storage (Local encrypted or restricted-access path)
FYERS_TOKEN_CACHE_PATH=./secrets/fyers_token.json

# Database Configuration
# Production uses PostgreSQL; Local testing/paper can default to SQLite
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mytradeview
TEST_DATABASE_URL=sqlite+aiosqlite:///./test_local.db

# Strategy Configuration (NIFTY ORB - StockMock Faithful)
STRATEGY_UNDERLYING_SYMBOL=NSE:NIFTY50-INDEX
STRATEGY_ORB_START_TIME=09:16:00
STRATEGY_ORB_END_TIME=09:45:00
STRATEGY_MANDATORY_EXIT_TIME=15:10:00
STRATEGY_LOTS=1
STRATEGY_LOT_SIZE=25
STRATEGY_TRADING_DAYS=Monday,Thursday,Friday

# Risk Parameters (INR)
MAX_DAILY_LOSS_LIMIT=3000.00
PROFIT_PROTECTION_TRIGGER=3000.00
PROFIT_PROTECTION_MIN_LOCK=500.00
PROFIT_TRAILING_STEP_PROFIT=1000.00
PROFIT_TRAILING_STEP_LOCK=500.00
MAX_SLIPPAGE_POINTS=5.0
MAX_RETRIES_PER_ORDER=3

# Alerting & Notifications (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=

# Logging
LOG_LEVEL=INFO
LOG_FILE_PATH=./logs/tradeview.log

